{
  "name": "backend-honojs",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply swapathon-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply swapathon-db --remote"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20251014.0",
    "drizzle-kit": "^0.31.6",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.10.4",
    "jose": "^6.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "wrangler": "^4.45.2"
  }
}
